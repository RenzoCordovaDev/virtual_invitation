# Copiar a .env.local (gitignored) y completar con los valores reales del
# proyecto Firebase "boda-teresa-renzo" (Configuración del proyecto > Tus apps
# en la consola de Firebase). Nunca comitear .env ni .env.local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" para que el SDK hable con los emuladores locales de Firebase
# (Auth :9099, Firestore :8080) en vez del proyecto real. Lo usan npm run
# test:e2e (ver playwright.config.ts) y el desarrollo local si corres
# `firebase emulators:start`. NUNCA en el build de producción.
VITE_USE_FIREBASE_EMULATOR=
